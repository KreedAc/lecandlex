---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProdottoCard from '../components/ProdottoCard.astro';
import BottoneWhatsApp from '../components/BottoneWhatsApp.astro';
import Bottone from '../components/Bottone.astro';
import { sito } from '../lib/sito';
import copertina from '../assets/copertina.jpg';
import ritratto from '../assets/alessia.jpg';

const prodotti = await getCollection('prodotti');
const inEvidenza = prodotti
  .filter((p) => p.data.inEvidenza)
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .slice(0, 4);

// La home non deve restare vuota per una dimenticanza nel CMS.
const vetrina = inEvidenza.length
  ? inEvidenza
  : prodotti.sort((a, b) => a.data.ordine - b.data.ordine).slice(0, 4);
---

<Base titolo={sito.nome}>
  <section class="contenitore grid items-center gap-10 py-12 lg:grid-cols-2 lg:gap-16 lg:py-20">
    <div>
      <p class="occhiello">{sito.sottotitolo}</p>
      <h1 class="mt-5 max-w-lg text-4xl leading-[1.08] text-balance sm:text-5xl lg:text-6xl">
        {sito.claim}
      </h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-fumo">
        Candele scultura e complementi d'arredo, fatti a mano uno per uno. Materiali 100% naturali e
        non testati sugli animali.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Bottone href="/catalogo/" dimensione="grande">Sfoglia il catalogo</Bottone>
        <BottoneWhatsApp
          variante="contorno"
          messaggio="Ciao Alessia! Vorrei qualche informazione."
          testo="Scrivimi"
        />
      </div>
    </div>

    <Image
      src={copertina}
      alt="Il marchio Le CandLex: un loto con una fiamma, su tessuto chiaro"
      widths={[500, 800, 1200]}
      sizes="(min-width: 1024px) 34rem, 92vw"
      loading="eager"
      fetchpriority="high"
      class="w-full rounded-xl object-cover"
    />
  </section>

  <section class="contenitore py-12">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-lino pb-5">
      <h2 class="text-3xl sm:text-4xl">Dal catalogo</h2>
      <a
        href="/catalogo/"
        class="text-sm text-fumo underline underline-offset-4 transition-colors hover:text-fiamma"
      >
        Tutte le collezioni
      </a>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3 lg:grid-cols-4">
      {vetrina.map((prodotto, i) => <ProdottoCard prodotto={prodotto} priorita={i < 4} />)}
    </div>
  </section>

  <section class="contenitore py-12">
    <div class="grid gap-8 sm:grid-cols-3">
      <a href="/catalogo/" class="group rounded-xl border border-lino bg-sabbia/50 p-7 transition-colors duration-200 hover:border-fiamma/40 hover:bg-sabbia">
        <h3 class="text-xl transition-colors group-hover:text-fiamma">Candele scultura</h3>
        <p class="mt-2 text-sm leading-relaxed text-fumo">
          Figure, fiori, animali e forme geometriche in cera. Molte nascono da stampi disegnati e
          realizzati qui, che non trovi altrove.
        </p>
      </a>
      <a href="/collezioni/mondo-jesmonite/" class="group rounded-xl border border-lino bg-sabbia/50 p-7 transition-colors duration-200 hover:border-fiamma/40 hover:bg-sabbia">
        <h3 class="text-xl transition-colors group-hover:text-fiamma">Arredo in ceramica</h3>
        <p class="mt-2 text-sm leading-relaxed text-fumo">
          Vassoi, svuotatasche, portagioie e vasi in Jesmonite. Personalizzabili nei colori e nelle
          composizioni.
        </p>
      </a>
      <a href="/eventi/" class="group rounded-xl border border-lino bg-sabbia/50 p-7 transition-colors duration-200 hover:border-fiamma/40 hover:bg-sabbia">
        <h3 class="text-xl transition-colors group-hover:text-fiamma">Bomboniere ed eventi</h3>
        <p class="mt-2 text-sm leading-relaxed text-fumo">
          Consulenza gratuita e attenzione al dettaglio. Qualunque articolo a catalogo può diventare
          una bomboniera.
        </p>
      </a>
    </div>
  </section>

  <section class="contenitore grid items-center gap-10 py-12 lg:grid-cols-[2fr_3fr] lg:gap-16">
    <Image
      src={ritratto}
      alt={`${sito.titolare}, che crea le candele Le CandLex`}
      widths={[400, 600, 900]}
      sizes="(min-width: 1024px) 24rem, 92vw"
      class="w-full rounded-xl object-cover"
    />
    <div>
      <p class="occhiello">Chi sono</p>
      <h2 class="mt-4 text-3xl sm:text-4xl">Dietro Le CandLex ci sono io</h2>
      <p class="mt-5 text-lg leading-relaxed text-fumo">
        «Mi chiamo Alessia, amo gli animali e la natura. Mi piace avere sempre nuove idee,
        sperimentare e creare cose nuove. Le CandLex nasce proprio da qui.»
      </p>
      <a
        href="/storia/"
        class="mt-6 inline-block text-sm underline underline-offset-4 transition-colors hover:text-fiamma"
      >
        Leggi tutto
      </a>
    </div>
  </section>
</Base>
