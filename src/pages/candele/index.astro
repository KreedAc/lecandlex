---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CandelaCard from '../../components/CandelaCard.astro';

const candele = await getCollection('candele');
const collezioni = (await getCollection('collezioni')).sort(
  (a, b) => a.data.ordine - b.data.ordine
);

// Raggruppiamo per collezione mantenendo l'ordine deciso nel CMS.
const gruppi = collezioni
  .map((collezione) => ({
    collezione,
    candele: candele
      .filter((c) => c.data.collezione?.id === collezione.id)
      .sort((a, b) => a.data.ordine - b.data.ordine),
  }))
  .filter((gruppo) => gruppo.candele.length > 0);

// Le candele senza collezione non spariscono: finiscono in fondo.
const senzaCollezione = candele
  .filter((c) => !c.data.collezione)
  .sort((a, b) => a.data.ordine - b.data.ordine);
---

<Base
  titolo="Le candele"
  descrizione="Tutte le candele di soia colate a mano: profumazioni permanenti ed edizioni stagionali."
>
  <section class="contenitore py-14 lg:py-20">
    <p class="occhiello">Catalogo</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">Le candele</h1>
    <p class="mt-5 max-w-xl leading-relaxed text-fumo">
      Ogni scheda riporta le note olfattive, la cera usata e la durata reale misurata durante i
      controlli. I prezzi sono quelli finali, spedizione esclusa.
    </p>
  </section>

  {
    gruppi.map(({ collezione, candele: elenco }) => (
      <section class="contenitore pb-16">
        <div class="border-b border-lino pb-5">
          <h2 class="text-2xl sm:text-3xl">{collezione.data.nome}</h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-fumo">{collezione.data.descrizione}</p>
        </div>
        <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {elenco.map((candela, i) => (
            <CandelaCard candela={candela} priorita={i < 2} />
          ))}
        </div>
      </section>
    ))
  }

  {
    senzaCollezione.length > 0 && (
      <section class="contenitore pb-16">
        <h2 class="border-b border-lino pb-5 text-2xl sm:text-3xl">Altre candele</h2>
        <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {senzaCollezione.map((candela) => (
            <CandelaCard candela={candela} />
          ))}
        </div>
      </section>
    )
  }
</Base>
