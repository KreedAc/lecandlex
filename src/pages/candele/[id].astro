---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BottoneWhatsApp from '../../components/BottoneWhatsApp.astro';
import CandelaCard from '../../components/CandelaCard.astro';
import { sito, prezzo, messaggioCandela } from '../../lib/sito';

export async function getStaticPaths() {
  const candele = await getCollection('candele');
  return candele.map((candela) => ({
    params: { id: candela.id },
    props: { candela },
  }));
}

// Il tipo di `candela` viene inferito dalle props restituite da getStaticPaths.
const { candela } = Astro.props;
const d = candela.data;
const { Content } = await render(candela);

const collezione = d.collezione
  ? (await getCollection('collezioni')).find((c) => c.id === d.collezione!.id)
  : undefined;

// Suggerimenti: stessa collezione, escludendo quella corrente.
const altre = (await getCollection('candele'))
  .filter((c) => c.id !== candela.id && c.data.collezione?.id === d.collezione?.id)
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .slice(0, 3);

const schede = [
  ['Cera', d.cera],
  ['Stoppino', d.stoppino],
  d.pesoGrammi ? ['Peso', `${d.pesoGrammi} g`] : null,
  d.durataOre ? ['Durata', `circa ${d.durataOre} ore`] : null,
].filter((r): r is [string, string] => r !== null);

const gruppiNote = [
  ['Note di testa', d.note.testa],
  ['Note di cuore', d.note.cuore],
  ['Note di fondo', d.note.fondo],
].filter(([, note]) => (note as string[]).length > 0) as [string, string[]][];

// Dati strutturati: e' cosi' che Google mostra prezzo e disponibilita'
// direttamente nei risultati di ricerca.
const datiStrutturati = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.nome,
  description: d.estratto,
  image: new URL(d.copertina.src, Astro.site).href,
  brand: { '@type': 'Brand', name: sito.nome },
  offers: {
    '@type': 'Offer',
    price: d.prezzo,
    priceCurrency: 'EUR',
    availability: d.disponibile
      ? 'https://schema.org/InStock'
      : 'https://schema.org/BackOrder',
    url: new URL(Astro.url.pathname, Astro.site).href,
  },
};
---

<Base titolo={d.nome} descrizione={d.estratto} immagine={d.copertina.src}>
  <div class="contenitore py-10">
    <nav aria-label="Percorso" class="text-sm text-fumo">
      <a href="/candele/" class="underline underline-offset-4 transition-colors hover:text-fiamma">
        Le candele
      </a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span>{d.nome}</span>
    </nav>
  </div>

  <article class="contenitore grid gap-10 pb-16 lg:grid-cols-2 lg:gap-16">
    <div class="space-y-4">
      <Image
        src={d.copertina}
        alt={d.altCopertina}
        widths={[500, 800, 1200]}
        sizes="(min-width: 1024px) 34rem, 92vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-4/5 w-full rounded-lg bg-sabbia object-cover"
      />
      {
        d.galleria.map((foto) => (
          <Image
            src={foto.file}
            alt={foto.alt}
            widths={[500, 800, 1200]}
            sizes="(min-width: 1024px) 34rem, 92vw"
            loading="lazy"
            class="aspect-4/5 w-full rounded-lg bg-sabbia object-cover"
          />
        ))
      }
    </div>

    <div class="lg:sticky lg:top-24 lg:self-start">
      {collezione && <p class="occhiello">{collezione.data.nome}</p>}
      <h1 class="mt-3 text-4xl sm:text-5xl">{d.nome}</h1>
      <p class="mt-4 text-2xl">{prezzo(d.prezzo)}</p>

      <p
        class:list={[
          'mt-3 inline-flex items-center gap-2 text-sm',
          d.disponibile ? 'text-salvia' : 'text-fumo',
        ]}
      >
        <span
          class:list={[
            'inline-block h-2 w-2 rounded-full',
            d.disponibile ? 'bg-salvia' : 'bg-lino',
          ]}
          aria-hidden="true"></span>
        {d.disponibile ? 'Disponibile, pronta da spedire' : 'Lotto esaurito, in preparazione'}
      </p>

      <div class="mt-7">
        <BottoneWhatsApp
          messaggio={messaggioCandela(d.nome, d.disponibile)}
          testo={d.disponibile ? 'Ordina su WhatsApp' : 'Avvisami quando torna'}
        />
        <p class="mt-3 text-xs text-fumo">
          Ti rispondo di persona, di solito in giornata.
        </p>
      </div>

      {
        gruppiNote.length > 0 && (
          <div class="mt-10 border-t border-lino pt-8">
            <h2 class="occhiello">Note olfattive</h2>
            <dl class="mt-5 space-y-4">
              {gruppiNote.map(([titolo, note]) => (
                <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
                  <dt class="w-32 shrink-0 text-fumo">{titolo}</dt>
                  <dd>{note.join(' · ')}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }

      <div class="mt-8 border-t border-lino pt-8">
        <h2 class="occhiello">Scheda tecnica</h2>
        <dl class="mt-5 space-y-4">
          {
            schede.map(([etichetta, valore]) => (
              <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
                <dt class="w-32 shrink-0 text-fumo">{etichetta}</dt>
                <dd>{valore}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div
        class="mt-8 space-y-4 border-t border-lino pt-8 leading-relaxed text-fumo [&_p]:text-base"
      >
        <Content />
      </div>

      <p class="mt-8 rounded-lg bg-sabbia p-5 text-sm leading-relaxed text-fumo">
        Alla prima accensione lasciala bruciare finché la cera non si è sciolta fino ai bordi:
        servono circa due ore. È il passaggio che decide come brucerà per tutta la sua vita.{' '}
        <a href="/cura/" class="underline underline-offset-4 transition-colors hover:text-fiamma">
          Come curarla
        </a>
      </p>
    </div>
  </article>

  {
    altre.length > 0 && (
      <section class="contenitore pb-8">
        <h2 class="border-b border-lino pb-5 text-2xl sm:text-3xl">Potrebbero piacerti</h2>
        <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {altre.map((c) => (
            <CandelaCard candela={c} />
          ))}
        </div>
      </section>
    )
  }

  <script type="application/ld+json" set:html={JSON.stringify(datiStrutturati)} is:inline />
</Base>
