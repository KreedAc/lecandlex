---
import Base from '../layouts/Base.astro';
import BottoneWhatsApp from '../components/BottoneWhatsApp.astro';
import IconaCura from '../components/IconaCura.astro';
import { sito, fragranze } from '../lib/sito';

// Avvertenze riprese dalla scheda "Piccoli Accorgimenti" del catalogo.
// L'icona sta qui accanto al testo che illustra: se un giorno cambia
// un'avvertenza, si vede subito quale disegno va cambiato con lei.
const avvertenze = [
  {
    icona: 'clessidra',
    titolo: 'Aspetta prima di accenderla',
    testo: `La stagionatura è fondamentale per la durata della tua candela. Aspetta almeno ${sito.stagionaturaGiorni} giorni prima di accenderla.`,
  },
  {
    icona: 'candela',
    titolo: 'Superficie piana',
    testo: 'Posiziona la candela su una superficie piana e stabile.',
  },
  {
    icona: 'orologio',
    titolo: 'Da 2 a 4 ore per volta',
    testo:
      'Oltre le quattro ore la cera si surriscalda e il contenitore diventa troppo caldo. Spegnila, lasciala raffreddare, riaccendila quando vuoi.',
  },
  {
    icona: 'forbici',
    titolo: 'Stoppino a circa 1 cm',
    testo:
      'Taglia lo stoppino prima di ogni accensione, a candela fredda. Uno stoppino lungo fa una fiamma alta che annerisce il contenitore.',
  },
  {
    icona: 'occhio',
    titolo: 'Mai incustodita',
    testo: 'Non lasciare la candela accesa senza sorveglianza.',
  },
  {
    icona: 'sole',
    titolo: 'Lontano da luce diretta e fiamme',
    testo: 'Tienila lontana dalla luce diretta del sole e da fonti infiammabili.',
  },
  {
    icona: 'zampa',
    titolo: 'Fuori portata',
    testo: 'Non lasciarla alla portata di bambini e animali.',
  },
] as const;
---

<Base
  titolo="Cura della candela"
  descrizione="Avvertenze e istruzioni utili per le candele Le CandLex, come pulire il barattolo e come richiedere il refill."
>
  <section class="contenitore py-12 lg:py-16">
    <p class="occhiello">Piccoli accorgimenti</p>
    <h1 class="mt-4 max-w-2xl text-4xl leading-tight sm:text-5xl">
      Avvertenze e istruzioni utili
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-fumo">
      Poche regole che fanno durare una candela molto più a lungo e la fanno bruciare in modo
      pulito.
    </p>
  </section>

  <section class="contenitore pb-14">
    <ol class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        avvertenze.map((regola, i) => (
          <li class="border-t border-lino pt-6">
            {/* Numero a sinistra, disegno a destra, stesso colore: sono
                due modi di dire la stessa cosa e devono sembrare una
                cosa sola. Il disegno riempie anche il vuoto in cima alla
                colonna, che senza sembrava spazio dimenticato. */}
            <div class="flex items-center justify-between text-lino">
              <span class="font-display text-3xl">{String(i + 1).padStart(2, '0')}</span>
              <IconaCura nome={regola.icona} class="h-8 w-8" />
            </div>
            <h2 class="mt-2 text-xl">{regola.titolo}</h2>
            <p class="mt-3 leading-relaxed text-fumo">{regola.testo}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="contenitore pb-14">
    <div class="grid gap-10 rounded-lg bg-sabbia p-8 sm:p-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl sm:text-3xl">Quando la candela finisce</h2>
        <div class="mt-5 space-y-4 leading-relaxed text-fumo">
          <p>
            Fai bollire un po' d'acqua in un pentolino e versala nel contenitore: in pochi minuti i
            residui di cera si staccheranno dal barattolo.
          </p>
          <p>
            Poi, sempre con acqua calda e un po' di sapone per piatti o comunque sgrassante, pulisci
            bene il contenitore e asciugalo con cura.
          </p>
          <p>
            Il barattolo diventa un porta caramelle, mentine, cotton fioc, dischetti struccanti e
            tante altre idee.
          </p>
        </div>
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl">Oppure fallo riempire di nuovo</h2>
        <p class="mt-5 leading-relaxed text-fumo">
          Se il barattolo ti piace e non vuoi separartene, posso fare il refill della tua candela
          preferita. Scrivimi e ci mettiamo d'accordo.
        </p>
        <div class="mt-7">
          <BottoneWhatsApp
            messaggio="Ciao Alessia! Vorrei fare il refill di una candela."
            testo="Chiedi il refill"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="contenitore pb-14">
    <h2 class="border-b border-lino pb-5 text-2xl sm:text-3xl">Le fragranze</h2>
    <p class="mt-5 max-w-xl leading-relaxed text-fumo">
      Le candele si possono profumare con una qualsiasi di queste. Dimmi quale preferisci quando
      ordini.
    </p>
    <ul class="mt-7 flex flex-wrap gap-2">
      {
        fragranze.map((f) => (
          <li class="rounded-full border border-lino px-4 py-1.5 text-sm">{f}</li>
        ))
      }
    </ul>
  </section>
</Base>
