---
import Base from '../layouts/Base.astro';
import BottoneWhatsApp from '../components/BottoneWhatsApp.astro';

const regole = [
  {
    titolo: 'La prima accensione decide tutto',
    testo:
      'Lasciala accesa finché la cera non arriva sciolta fino ai bordi del contenitore: circa due ore. La cera ha memoria — se la spegni prima, continuerà a scavare un tunnel al centro per tutta la sua vita, sprecando metà candela.',
  },
  {
    titolo: 'Taglia lo stoppino a 5 mm',
    testo:
      'Ogni volta, prima di accendere, a candela fredda. Uno stoppino lungo fa una fiamma alta che annerisce il vetro e brucia la cera troppo in fretta. Vanno bene delle forbicine, non serve nulla di speciale.',
  },
  {
    titolo: 'Mai più di quattro ore di seguito',
    testo:
      'Oltre le quattro ore la cera si surriscalda, il profumo si sfalda e il contenitore diventa troppo caldo. Spegnila, lasciala raffreddare, riaccendila quando vuoi.',
  },
  {
    titolo: 'Spegnila senza soffiare',
    testo:
      'Soffiare sparge fumo e cera. Meglio uno spegnifiamma, oppure immergi lo stoppino nella cera liquida con uno stuzzicadenti e rialzalo subito: si spegne senza fumo e lo stoppino resta imbevuto per la volta dopo.',
  },
  {
    titolo: 'Lontano da correnti d’aria',
    testo:
      'Una finestra aperta o un condizionatore fanno oscillare la fiamma, che brucia in modo irregolare e annerisce un lato solo del vetro.',
  },
  {
    titolo: 'Fermati a un centimetro dal fondo',
    testo:
      'Quando resta circa un centimetro di cera, la candela ha finito. Continuare surriscalda il vetro. Sciacqua il barattolo con acqua calda: diventa un portapenne o un portacandeline perfetto.',
  },
];
---

<Base
  titolo="Cura della candela"
  descrizione="Sei regole semplici per far durare una candela di soia il doppio e farla bruciare in modo pulito."
>
  <section class="contenitore py-14 lg:py-20">
    <p class="occhiello">Istruzioni</p>
    <h1 class="mt-4 max-w-2xl text-4xl leading-tight sm:text-5xl">Come far durare una candela il doppio</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-fumo">
      Quasi tutti i problemi di una candela — il tunnel al centro, il vetro nero, il profumo che
      sparisce dopo tre accensioni — nascono da due o tre gesti sbagliati. Sono facili da evitare.
    </p>
  </section>

  <section class="contenitore pb-16">
    <ol class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
      {
        regole.map((regola, i) => (
          <li class="border-t border-lino pt-6">
            <span class="font-display text-3xl text-lino">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="mt-2 text-xl">{regola.titolo}</h2>
            <p class="mt-3 leading-relaxed text-fumo">{regola.testo}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="contenitore pb-16">
    <div class="rounded-lg bg-sabbia p-8 sm:p-12">
      <h2 class="text-2xl sm:text-3xl">La tua candela fa qualcosa di strano?</h2>
      <p class="mt-3 max-w-lg leading-relaxed text-fumo">
        Mandami una foto su WhatsApp. Nella maggior parte dei casi si recupera — anche un tunnel
        già formato si può sistemare.
      </p>
      <div class="mt-7">
        <BottoneWhatsApp messaggio="Ciao! Ho un problema con la mia candela, ti mando una foto." />
      </div>
    </div>
  </section>
</Base>
