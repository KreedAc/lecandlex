---
import Base from '../layouts/Base.astro';
import BottoneWhatsApp from '../components/BottoneWhatsApp.astro';
import { sito, linkInstagram } from '../lib/sito';

const faq = [
  {
    domanda: 'Come si ordina?',
    risposta:
      'Scrivimi su WhatsApp o su Instagram dicendomi cosa ti interessa. Ti confermo disponibilità e totale, e ti mando i dettagli per il pagamento. Non c’è un carrello: preferisco parlare con chi compra.',
  },
  {
    domanda: 'Posso scegliere la fragranza?',
    risposta:
      'Sì. Le candele si possono profumare con una qualsiasi delle fragranze disponibili, elencate nella pagina Cura. Dimmi quale preferisci quando ordini.',
  },
  {
    domanda: 'Posso scegliere i colori?',
    risposta:
      'Sì, sia per le candele che per gli articoli in Jesmonite. Colori e composizioni sono personalizzabili: mandami un riferimento e vediamo cosa si può fare.',
  },
  {
    domanda: 'Cosa vuol dire "stampo esclusivo"?',
    risposta:
      'Che quello stampo è stato creato da zero direttamente da Le CandLex. Quei pezzi non esistono in nessun altro catalogo.',
  },
  {
    domanda: 'Fate bomboniere?',
    risposta: `Sì, e qualunque articolo a catalogo può diventarne una. La consulenza è gratuita, ma servono almeno ${sito.preavvisoBomboniereMesi} mesi di preavviso.`,
  },
  {
    domanda: 'C’è un minimo d’ordine?',
    risposta: `No. Però per ordini uguali o superiori a ${sito.omaggioDa} € c’è un omaggio a sorpresa.`,
  },
  {
    domanda: 'Un pezzo non è disponibile, quando torna?',
    risposta:
      'Dipende dal lotto e dalla stagione. Scrivimi e ti dico i tempi reali, oppure ti avviso appena è pronto.',
  },
];
---

<Base
  titolo="Contatti"
  descrizione="Come ordinare da Le CandLex, personalizzazioni, bomboniere e risposte alle domande più frequenti."
>
  <section class="contenitore grid gap-12 py-12 lg:grid-cols-2 lg:gap-16 lg:py-16">
    <div>
      <p class="occhiello">Contatti</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">Scrivimi</h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-fumo">
        Ti rispondo io, non un servizio clienti. Se hai un'idea in testa e non sai se si può fare,
        chiedimela: quasi sempre la risposta è sì.
      </p>

      <div class="mt-8">
        <BottoneWhatsApp messaggio="Ciao Alessia! Vorrei qualche informazione." />
      </div>

      <dl class="mt-10 space-y-5 border-t border-lino pt-8 text-sm">
        <div>
          <dt class="text-fumo">Telefono</dt>
          <dd class="mt-1">{sito.telefonoLeggibile}</dd>
        </div>
        <div>
          <dt class="text-fumo">Instagram</dt>
          <dd class="mt-1">
            <a
              class="underline underline-offset-4 transition-colors hover:text-fiamma"
              href={linkInstagram}
              rel="me noopener"
            >
              @{sito.instagram}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-fumo">Facebook</dt>
          <dd class="mt-1">{sito.facebook}</dd>
        </div>
        <div>
          <dt class="text-fumo">Email</dt>
          <dd class="mt-1">
            <a
              class="underline underline-offset-4 transition-colors hover:text-fiamma"
              href={`mailto:${sito.email}`}
            >
              {sito.email}
            </a>
          </dd>
        </div>
      </dl>

      <p class="mt-8 text-sm text-fumo">Seguimi su Instagram e taggami nelle tue foto.</p>
    </div>

    <div>
      <h2 class="text-2xl sm:text-3xl">Domande frequenti</h2>
      <div class="mt-7 divide-y divide-lino border-t border-lino">
        {
          faq.map((voce) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left">
                <span class="font-medium">{voce.domanda}</span>
                <span
                  class="shrink-0 text-fumo transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-fumo">{voce.risposta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
