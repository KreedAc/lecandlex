---
import Base from '../layouts/Base.astro';
import BottoneWhatsApp from '../components/BottoneWhatsApp.astro';
import { sito, linkInstagram } from '../lib/sito';

const faq = [
  {
    domanda: 'Come si ordina?',
    risposta:
      'Scrivimi su WhatsApp o su Instagram dicendomi quale candela ti interessa e quante ne vuoi. Ti confermo disponibilità e totale, e ti mando i dettagli per il pagamento.',
  },
  {
    domanda: 'Quanto costa la spedizione?',
    risposta: `${sito.spedizione.costo} in tutta Italia, gratis sopra ${sito.spedizione.gratisDa}. Consegna in ${sito.spedizione.tempi}. I barattoli viaggiano imballati singolarmente.`,
  },
  {
    domanda: 'Posso ritirare di persona?',
    risposta:
      'Sì, se sei in zona ci mettiamo d’accordo e risparmi la spedizione. Scrivimi e organizziamo.',
  },
  {
    domanda: 'Fate bomboniere o regali aziendali?',
    risposta:
      'Sì, su ordinazione, con etichetta personalizzata. Servono almeno tre settimane di preavviso perché ogni lotto ha bisogno dei suoi tempi di riposo.',
  },
  {
    domanda: 'Una candela è esaurita, quando torna?',
    risposta:
      'Le permanenti tornano di solito entro due o tre settimane. Le stagionali tornano nella loro stagione. Scrivimi e ti avviso appena il lotto è pronto.',
  },
  {
    domanda: 'Sono adatte a chi ha allergie?',
    risposta:
      'Le fragranze contengono allergeni cosmetici dichiarati sull’etichetta di ogni barattolo. Se hai una sensibilità specifica scrivimi prima di ordinare e controllo insieme a te.',
  },
];
---

<Base
  titolo="Contatti"
  descrizione="Come ordinare, spedizioni, tempi di consegna e risposte alle domande più frequenti."
>
  <section class="contenitore grid gap-12 py-14 lg:grid-cols-2 lg:gap-16 lg:py-20">
    <div>
      <p class="occhiello">Contatti</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">Scrivimi</h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-fumo">
        Non c’è un carrello e non è una dimenticanza: preferisco sapere chi compra le mie candele.
        Scrivimi e ne parliamo — rispondo di solito in giornata.
      </p>

      <div class="mt-9">
        <BottoneWhatsApp messaggio="Ciao! Vorrei qualche informazione sulle candele." />
      </div>

      <dl class="mt-10 space-y-5 border-t border-lino pt-8 text-sm">
        <div>
          <dt class="text-fumo">Instagram</dt>
          <dd class="mt-1">
            <a class="underline underline-offset-4 transition-colors hover:text-fiamma" href={linkInstagram} rel="me noopener">
              @{sito.instagram}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-fumo">Email</dt>
          <dd class="mt-1">
            <a class="underline underline-offset-4 transition-colors hover:text-fiamma" href={`mailto:${sito.email}`}>
              {sito.email}
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div>
      <h2 class="text-2xl sm:text-3xl">Domande frequenti</h2>
      <div class="mt-7 divide-y divide-lino border-t border-lino">
        {
          faq.map((voce) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left">
                <span class="font-medium">{voce.domanda}</span>
                <span
                  class="shrink-0 text-fumo transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-fumo">{voce.risposta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
