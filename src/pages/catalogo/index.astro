---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NavCollezioni from '../../components/NavCollezioni.astro';
import ProdottoCard from '../../components/ProdottoCard.astro';
import BottoneWhatsApp from '../../components/BottoneWhatsApp.astro';
import { prezzo, prezziInGriglia } from '../../lib/sito';

const prodotti = await getCollection('prodotti');
const collezioni = (await getCollection('collezioni')).sort(
  (a, b) => a.data.ordine - b.data.ordine
);

const gruppi = collezioni
  .map((collezione) => {
    const suoi = prodotti
      .filter((p) => p.data.collezione?.id === collezione.id)
      .sort((a, b) => a.data.ordine - b.data.ordine);

    const prezziMinimi = suoi
      .flatMap((p) => [p.data.prezzo, ...p.data.varianti.map((v) => v.prezzo)])
      .filter((v): v is number => typeof v === 'number');

    return {
      collezione,
      prodotti: suoi,
      da: prezziMinimi.length ? Math.min(...prezziMinimi) : undefined,
      esclusivi: suoi.filter((p) => p.data.stampoEsclusivo).length,
    };
  })
  .filter((g) => g.prodotti.length > 0);

const vuote = collezioni.filter((c) => !prodotti.some((p) => p.data.collezione?.id === c.id));

const orfani = prodotti
  .filter((p) => !p.data.collezione)
  .sort((a, b) => a.data.ordine - b.data.ordine);

// Solo le prime immagini della pagina vanno caricate subito. Tutte le
// altre restano pigre: con 192 prodotti su una pagina sola, caricarle
// tutte in partenza sarebbe un disastro su rete mobile.
let contatoreImmagini = 0;
---

<Base
  titolo="Catalogo"
  descrizione="Candele scultura e complementi d'arredo in ceramica, divisi per collezione."
>
  <NavCollezioni modo="ancore" />

  <!-- Il titolo resta nel documento ma non a schermo: ogni pagina deve
       averne uno per i motori di ricerca e per chi naviga con un lettore
       vocale. A vista si parte direttamente dai prodotti. -->
  <h1 class="sr-only">Catalogo</h1>

  <!-- Tutte le collezioni una sotto l'altra: si scorre e basta. La barra
       qui sopra accende da sola quella che si sta guardando.

       `scroll-mt` tiene conto delle due barre appiccicate: senza, saltando
       a una collezione il suo titolo finirebbe nascosto dietro. -->
  {
    gruppi.map(({ collezione, prodotti: elenco, da, esclusivi }) => (
      <section
        id={collezione.id}
        data-sezione-collezione={collezione.id}
        class="contenitore scroll-mt-28 pt-10 pb-14 lg:scroll-mt-44"
      >
        <div class="border-b border-lino pb-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-2xl sm:text-3xl">{collezione.data.nome}</h2>
            <p class="text-sm text-fumo tabular-nums">
              {elenco.length} {elenco.length === 1 ? 'pezzo' : 'pezzi'}
              {prezziInGriglia && da !== undefined && ` · da ${prezzo(da)}`}
              {esclusivi > 0 && ` · ${esclusivi} a stampo esclusivo`}
            </p>
          </div>

          {collezione.data.descrizione && (
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-fumo">
              {collezione.data.descrizione}
            </p>
          )}
        </div>

        <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
          {elenco.map((prodotto) => (
            <ProdottoCard prodotto={prodotto} priorita={contatoreImmagini++ < 4} />
          ))}
        </div>
      </section>
    ))
  }

  {
    orfani.length > 0 && (
      <section class="contenitore scroll-mt-28 pb-14 lg:scroll-mt-44">
        <h2 class="border-b border-lino pb-5 text-2xl sm:text-3xl">Altri prodotti</h2>
        <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
          {orfani.map((prodotto) => (
            <ProdottoCard prodotto={prodotto} />
          ))}
        </div>
      </section>
    )
  }

  {
    vuote.length > 0 && (
      <section class="contenitore pb-14">
        <div class="rounded-xl bg-sabbia p-8 sm:p-10">
          <h2 class="text-2xl">Altre collezioni in arrivo online</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-fumo">
            Esistono a catalogo ma non sono ancora qui. Se cerchi qualcosa in particolare, scrivimi:
            te lo mando in foto.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {vuote.map((c) => (
              <li class="rounded-full border border-lino bg-crema px-4 py-1.5 text-sm">
                {c.data.nome}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="contenitore pb-16">
    <div class="rounded-xl bg-sabbia p-8 text-center sm:p-12">
      <h2 class="text-2xl sm:text-3xl">Non trovi quello che cerchi?</h2>
      <p class="mx-auto mt-3 max-w-md leading-relaxed text-fumo">
        Colori e fragranze si scelgono, e su richiesta creo anche pezzi che non sono a catalogo.
      </p>
      <div class="mt-7">
        <BottoneWhatsApp messaggio="Ciao Alessia! Ho guardato il catalogo e volevo chiederti una cosa." />
      </div>
    </div>
  </section>
</Base>
