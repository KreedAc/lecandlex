---
import { Image } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sito, sfondo, veloSfondo } from '../lib/sito';

interface Props {
  titolo: string;
  descrizione?: string;
  /** URL assoluto o path dell'immagine per l'anteprima social. */
  immagine?: string;
  /** Per le pagine di servizio che non devono finire su Google. */
  noindex?: boolean;
}

const { titolo, descrizione = sito.descrizione, immagine, noindex = false } = Astro.props;

const titoloCompleto =
  titolo === sito.nome ? `${sito.nome} — ${sito.sottotitolo}` : `${titolo} — ${sito.nome}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const anteprima = immagine ? new URL(immagine, Astro.site).href : undefined;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={sito.nome} />
    <meta property="og:title" content={titoloCompleto} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonical} />
    {anteprima && <meta property="og:image" content={anteprima} />}
    <meta name="twitter:card" content={anteprima ? 'summary_large_image' : 'summary'} />
  </head>

  <body>
    {/* La foto di sfondo, dietro tutto e ferma mentre si scorre.
        `background-attachment: fixed` farebbe la stessa cosa in una riga,
        ma su iPhone singhiozza: meglio un riquadro fisso vero.

        Sopra ci sta il colore di sempre, reso trasparente quel tanto che
        basta a far trasparire la foto senza rendere faticoso il testo —
        di quanto esattamente lo decide `veloSfondo`, che porta con se' i
        conti sul contrasto. Il colore pieno del `body` resta sotto: se la
        foto non arriva, la pagina e' quella di prima. */}
    {
      sfondo && (
        <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
          <Image
            src={sfondo}
            alt=""
            widths={[900, 1500, 2200]}
            sizes="100vw"
            loading="eager"
            fetchpriority="low"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-crema" style={`opacity:${veloSfondo}`} />
        </div>
      )
    }

    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-inchiostro focus:px-5 focus:py-2.5 focus:text-sm focus:text-crema"
    >
      Vai al contenuto
    </a>

    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
