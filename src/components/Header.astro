---
import { sito } from '../lib/sito';

const percorso = Astro.url.pathname;
const voci = [
  { href: '/catalogo/', testo: 'Catalogo' },
  { href: '/eventi/', testo: 'Bomboniere' },
  { href: '/storia/', testo: 'Chi sono' },
  { href: '/cura/', testo: 'Cura' },
  { href: '/contatti/', testo: 'Contatti' },
];

// Il catalogo si raggiunge anche dalle pagine delle collezioni: la voce
// del menu deve restare accesa anche li'.
const attiva = (href: string) =>
  percorso === href ||
  percorso.startsWith(href) ||
  (href === '/catalogo/' && percorso.startsWith('/collezioni/'));
---

<!-- Altezza fissa, dichiarata in global.css: la barra delle collezioni si
     appiccica esattamente sotto questa misura, e due valori che devono
     combaciare e' meglio scriverli una volta sola.

     Logo e menu su una riga anche su mobile: due righe raddoppiavano
     l'ingombro, e sommate alla barra delle collezioni mangiavano un terzo
     dello schermo del telefono. Il menu scorre, con una sfumatura sul
     bordo che dice che continua.

     L'elenco parte da sinistra e non e' allineato a destra: allineandolo
     a destra l'eccedenza finiva a sinistra, fuori dallo schermo e senza
     modo di raggiungerla. Da tablet in su, dove ci sta tutto, torna a
     destra. -->
<header
  class="sticky top-0 z-40 h-(--altezza-intestazione) border-b border-lino bg-crema"
>
  <div class="contenitore relative flex h-full items-center gap-4">
    <a href="/" class="shrink-0 font-display text-xl leading-none tracking-tight sm:text-2xl">
      {sito.nome}
    </a>

    <nav
      aria-label="Principale"
      class="-mr-6 min-w-0 flex-1 overflow-x-auto pr-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <ul class="flex items-center gap-4 whitespace-nowrap text-sm sm:justify-end sm:gap-6">
        {
          voci.map((voce) => (
            <li>
              <a
                href={voce.href}
                aria-current={attiva(voce.href) ? 'page' : undefined}
                class:list={[
                  'block py-2 transition-colors duration-200 hover:text-fiamma',
                  attiva(voce.href) ? 'text-fiamma' : 'text-fumo',
                ]}
              >
                {voce.testo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-crema to-transparent sm:hidden"
      aria-hidden="true"
    >
    </div>
  </div>
</header>
