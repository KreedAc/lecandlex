---
import { sito, linkWhatsApp, linkInstagram } from '../lib/sito';

const anno = new Date().getFullYear();
---

<footer class="mt-20 border-t border-lino bg-sabbia">
  <div class="contenitore grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="font-display text-2xl">{sito.nome}</p>
      <p class="mt-1 text-sm text-fumo">{sito.sottotitolo}</p>
      <p class="mt-4 max-w-xs font-display text-lg leading-snug">{sito.claim}</p>
    </div>

    <div>
      <p class="occhiello">Scrivimi</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a
            class="transition-colors hover:text-fiamma"
            href={linkWhatsApp('Ciao Alessia! Vorrei qualche informazione.')}
          >
            WhatsApp {sito.telefonoLeggibile}
          </a>
        </li>
        <li>
          <a class="transition-colors hover:text-fiamma" href={linkInstagram} rel="me noopener">
            Instagram @{sito.instagram}
          </a>
        </li>
        <li>
          <a class="transition-colors hover:text-fiamma" href={`mailto:${sito.email}`}>
            {sito.email}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="occhiello">Buono a sapersi</p>
      <ul class="mt-4 space-y-2 text-sm text-fumo">
        <li>Materiali 100% naturali, non testati sugli animali</li>
        <li>Omaggio a sorpresa per ordini da {sito.omaggioDa} €</li>
        <li>Bomboniere con {sito.preavvisoBomboniereMesi} mesi di preavviso</li>
        <li>Refill delle candele in barattolo su richiesta</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-lino">
    <div
      class="contenitore flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-fumo"
    >
      <p>© {anno} {sito.nome} — {sito.titolare}</p>
      <p>Fatto a mano in {sito.citta}</p>
    </div>
  </div>
</footer>
