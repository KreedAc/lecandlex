---
import attesa from '../assets/cura/attesa.png';
import superficie from '../assets/cura/superficie.png';
import durata from '../assets/cura/durata.png';
import stoppino from '../assets/cura/stoppino.png';
import sorveglianza from '../assets/cura/sorveglianza.png';
import lontananza from '../assets/cura/lontananza.png';
import portata from '../assets/cura/portata.png';

/**
 * Le icone delle avvertenze sulla cura della candela.
 *
 * Ritagliate una per una dal foglio disegnato per Le CandLex e
 * scontornate: la carta e' diventata trasparente, cosi' si appoggiano sul
 * colore della pagina senza portarsi dietro un rettangolo piu' grigio.
 * Il foglio di partenza e lo script che le ritaglia stanno in `disegni/`:
 * per rifarle, o per rifarle di misura diversa, si rilancia quello.
 *
 * Passano apposta *fuori* dal componente <Image> di Astro, che nel resto
 * del sito e' la scelta giusta. Qui no: sono disegni piatti a due colori,
 * e su questi il WebP con perdita spreca. Misurato — Astro le serviva a
 * 14 kB l'una, un PNG a tavolozza ne pesa 3,5. Sono gia' salvate a 192 px,
 * il doppio dei 96 a cui si vedono, quindi restano nitide anche su schermi
 * fitti e non serve nessuna variante.
 *
 * Sono decorative: quello che dicono e' gia' scritto nel titolo accanto,
 * quindi restano nascoste ai lettori vocali.
 *
 * Nota su `stoppino`: nel foglio consegnato quella casella manca — il set
 * salta dalla 03 alla 05 — quindi questa e' disegnata qui, ricalcata sulle
 * misure delle altre: stesso anello, stessi due colori. E' stata
 * approvata, quindi e' definitiva: non e' un segnaposto in attesa di
 * niente. La rifa' `disegni/stoppino.mjs`.
 */
const disegni = {
  attesa,
  superficie,
  durata,
  stoppino,
  sorveglianza,
  lontananza,
  portata,
} as const;

interface Props {
  nome: keyof typeof disegni;
  class?: string;
}

const { nome, class: classe = '' } = Astro.props;
const disegno = disegni[nome];
---

<img
  src={disegno.src}
  alt=""
  aria-hidden="true"
  width="96"
  height="96"
  loading="lazy"
  decoding="async"
  class:list={[classe]}
/>
