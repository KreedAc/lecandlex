---
import { linkWhatsApp } from '../lib/sito';

interface Props {
  messaggio: string;
  testo?: string;
  variante?: 'pieno' | 'contorno';
  class?: string;
}

const { messaggio, testo = 'Scrivimi su WhatsApp', variante = 'pieno', class: classe = '' } = Astro.props;

const stili = {
  pieno: 'bg-fiamma text-crema hover:bg-fiamma-scuro',
  contorno: 'border border-inchiostro text-inchiostro hover:bg-inchiostro hover:text-crema',
};
---

<a
  href={linkWhatsApp(messaggio)}
  target="_blank"
  rel="noopener"
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-full px-6 py-3 text-sm font-medium transition-colors',
    stili[variante],
    classe,
  ]}
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"
    ></path>
    <path
      d="M12.04 2C6.6 2 2.18 6.42 2.18 11.86c0 1.74.46 3.44 1.32 4.94L2.1 22l5.34-1.4a9.83 9.83 0 0 0 4.6 1.17h.01c5.43 0 9.85-4.42 9.85-9.86A9.8 9.8 0 0 0 12.04 2Zm0 17.98h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.15 8.15 0 0 1-1.25-4.36c0-4.52 3.68-8.2 8.2-8.2a8.19 8.19 0 0 1 8.19 8.2c0 4.52-3.68 8.2-8.19 8.2Z"
    ></path>
  </svg>
  {testo}
</a>
