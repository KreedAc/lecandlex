---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { prezzoEsposto } from '../lib/sito';
import segnaposto from '../assets/segnaposto.jpg';

interface Props {
  prodotto: CollectionEntry<'prodotti'>;
  /** Le prime immagini della griglia non vanno caricate in lazy. */
  priorita?: boolean;
}

const { prodotto, priorita = false } = Astro.props;
const d = prodotto.data;

// Un prodotto senza foto mostra un segnaposto invece di far fallire la build.
const foto = d.copertina ?? segnaposto;
const descrizioneFoto = d.altCopertina ?? d.nome;
const dettagli = [d.dimensioni, d.pesoGrammi ? `${d.pesoGrammi} g` : null]
  .filter(Boolean)
  .join(' · ');
---

<article>
  <a href={`/catalogo/${prodotto.id}/`} class="group block">
    <div class="relative overflow-hidden rounded-xl bg-sabbia">
      <Image
        src={foto}
        alt={descrizioneFoto}
        widths={[300, 500, 800]}
        sizes="(min-width: 1024px) 20rem, (min-width: 640px) 30vw, 45vw"
        loading={priorita ? 'eager' : 'lazy'}
        class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
      />

      {
        d.stampoEsclusivo && (
          <span class="absolute top-3 left-3 rounded-full bg-crema/90 px-2.5 py-1 text-[0.7rem] font-medium tracking-wide text-inchiostro backdrop-blur-sm">
            Stampo esclusivo
          </span>
        )
      }

      {
        !d.disponibile && (
          <span class="absolute inset-x-0 bottom-0 bg-inchiostro/80 py-2 text-center text-xs font-medium text-crema">
            In preparazione
          </span>
        )
      }
    </div>

    <div class="mt-3.5">
      <h3
        class="text-[1.05rem] leading-snug transition-colors duration-200 group-hover:text-fiamma"
      >
        {d.nome}
      </h3>
      {dettagli && <p class="mt-1 text-xs text-fumo tabular-nums">{dettagli}</p>}
      <p class="mt-2 text-sm font-medium tabular-nums">{prezzoEsposto(d)}</p>
    </div>
  </a>
</article>
