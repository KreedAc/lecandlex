{
  // Configurazione del deploy su Cloudflare Workers.
  //
  // Nel pannello di Cloudflare i campi "framework" e "cartella di output"
  // non esistono: le impostazioni stanno qui. Nel pannello servono solo
  //   Build command:  npm run build
  //   Deploy command: npx wrangler deploy
  //
  // Il branch di produzione e' quello predefinito del repository (main).
  "name": "lecandlex",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",

  "assets": {
    // La cartella che produce `npm run build`. Senza questa riga Wrangler
    // non sa cosa pubblicare, ed e' il motivo per cui le immagini non
    // venivano servite.
    "directory": "./dist",
    "binding": "ASSETS",
    // DEVE restare "none".
    //
    // Con "404-page" e' il gestore degli asset a rispondere agli indirizzi
    // che non corrispondono a un file, e lo fa restituendo la pagina 404
    // *senza mai eseguire il Worker*. Il risultato e' che /auth e
    // /callback — che non sono file ma codice — finivano anche loro sulla
    // pagina 404, e il login del pannello non poteva funzionare.
    //
    // Con "none" gli indirizzi senza file passano al Worker, che gestisce
    // il login e per tutto il resto restituisce lui la pagina 404.
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  }
}
